VITE_API_URL=http://localhost:8080/api/v1
VITE_MOCK_API=false
VITE_SKIP_AUTH=true
VITE_AI_COACH=true
# Pin the auth provider for the unit suite so a developer's gitignored .env.local
# (e.g. VITE_AUTH_PROVIDER=firebase for GCP work) can't leak in and route cognito-path
# tests through the unmocked firebase adapter. Matches the app's production default.
VITE_AUTH_PROVIDER=cognito
