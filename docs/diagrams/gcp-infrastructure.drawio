          <mxGeometry x="940" y="120" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="gcs" value="GCS bucket&#10;sudoku-tf-state-gcp&#10;versioned · UBLA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1180" y="120" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Row 2: runtime service accounts (directly under Firestore) -->
        <mxCell id="sa_run" value="SA: sudoku-run&#10;backend runtime · datastore.user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#F9AB00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="250" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sa_ir" value="SA: sudoku-image-recognition-run&#10;IR runtime · datastore.user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#F9AB00;fontSize=12;" vertex="1" parent="1">
