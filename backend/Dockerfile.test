# Integration test image — runs Quarkus in dev mode so the Lambda mock HTTP server starts on port 8080.
# Used by docker-compose.test.yml only; not deployed to production.
FROM maven:3-eclipse-temurin-25
WORKDIR /build

# Use a cache mount for the local repository
COPY pom.xml ./
RUN --mount=type=cache,target=/root/.m2 \
    mvn dependency:resolve -q

COPY src/ src/
EXPOSE 8080

# Keep using dev mode for integration tests as requested
ENTRYPOINT ["mvn", "quarkus:dev", "-Dquarkus.http.host=0.0.0.0", "-Ddebug=false", "-Dquarkus.console.enabled=false", "-Dquarkus.live-reload.enabled=false"]
