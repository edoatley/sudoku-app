        <!-- ============ cross edges ============ -->
        <mxCell id="e5" value="terraform apply" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;labelBackgroundColor=#ffffff;fontSize=11;strokeColor=#673AB7;" edge="1" parent="1" source="tf" target="project">
          <mxGeometry relative="1" as="geometry" />
