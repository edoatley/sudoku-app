# Builds the Vite app and serves it with `vite preview` for integration testing.
FROM node:26-slim AS build
WORKDIR /app

# 1. Cache dependencies separately
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --legacy-peer-deps

# 2. Move ARGs above COPY . .
# This ensures that changing source code doesn't invalidate the ARG layers
ARG VITE_API_URL=http://localhost:8080/api/v1
ARG VITE_MOCK_API=false
ARG VITE_SKIP_AUTH=false
ARG VITE_DEV_TOOLS=false

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_MOCK_API=$VITE_MOCK_API
ENV VITE_SKIP_AUTH=$VITE_SKIP_AUTH
ENV VITE_DEV_TOOLS=$VITE_DEV_TOOLS

# 3. Copy source and build
COPY . .
RUN npm run build

FROM node:26-slim
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/package.json ./
EXPOSE 5174
CMD ["npx", "vite", "preview", "--host", "0.0.0.0", "--port", "5174"]
