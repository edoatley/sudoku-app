<mxfile host="app.diagrams.net">
  <diagram id="gcp-infra" name="GCP Infrastructure">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1500" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Sudoku on GCP — project sudoku-app-eo · region us-central1 (live in prod — sudoku-gcp.edoatley.co.uk)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="30" as="geometry" />
        </mxCell>

        <!-- ============ CI / CD + Trust column ============ -->
        <mxCell id="cicd" value="CI/CD &amp; Trust" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#616161;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="300" height="600" as="geometry" />
        </mxCell>
        <mxCell id="gh_repo" value="GitHub&#10;edoatley/sudoku-app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#24292E;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="100" width="240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="gh_wf" value="GitHub Actions&#10;deploy-gcp.yml (workflow_dispatch)&#10;auth@v3 · terraform apply" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#24292E;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="195" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="wif" value="Workload Identity Federation&#10;github-pool / github-provider&#10;repo-restricted · no keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#F9AB00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="300" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="deploy_sa" value="SA: sudoku-github-deploy&#10;impersonated via WIF&#10;run/firebase/datastore/dns admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#F9AB00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="410" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tf" value="Terraform (infra/gcp)&#10;state → GCS backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#673AB7;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="520" width="240" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="gh_repo" target="gh_wf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="OIDC token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="gh_wf" target="wif">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="impersonate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="wif" target="deploy_sa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="runs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="deploy_sa" target="tf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ GCP project container ============ -->
        <mxCell id="project" value="GCP project: sudoku-app-eo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4285F4;verticalAlign=top;fontStyle=1;fontSize=13;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="400" y="70" width="1060" height="600" as="geometry" />
        </mxCell>

        <!-- Deployed group label -->
        <mxCell id="dep_lbl" value="Deployed (live · ~$0 idle)" style="text;html=1;fontSize=12;fontStyle=1;align=left;fontColor=#1A73E8;" vertex="1" parent="1">
          <mxGeometry x="420" y="90" width="300" height="20" as="geometry" />
        </mxCell>

        <!-- Row 1: data / hosting -->
        <mxCell id="firestore" value="Firestore (default)&#10;Native · us-central1&#10;PITR · delete-protection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;" vertex="1" parent="1">
