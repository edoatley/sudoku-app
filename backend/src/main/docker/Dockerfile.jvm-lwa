####
# Unified HTTP container image for the Quarkus backend, used on BOTH clouds:
#   - Google Cloud Run: runs the app as a plain HTTP server on :8080.
#   - AWS Lambda (container): the AWS Lambda Web Adapter extension (baked in below) bridges the
#     Lambda Runtime API to the same HTTP server, so no code or handler change is needed.
# The adapter is a Lambda "extension"; outside a Lambda execution environment (e.g. on Cloud Run)
# it is never invoked and stays completely inert.
#
# Base image: Amazon Corretto on Amazon Linux 2023 — deliberately the same OS family AWS Lambda's
# own managed base images use. We originally used the Red Hat UBI openjdk image; it boots fine on
# Cloud Run and `docker run`, but AWS Lambda's container runtime could not exec ANY binary from it
# (`Runtime.InvalidEntrypoint: fork/exec <entrypoint>: permission denied` — reproduced with both
# the run-java.sh wrapper and the java binary as ENTRYPOINT, after ruling out file permissions,
# architecture, image manifest format, and adapter version). An AL2023 base sidesteps it entirely;
# verified booting on Lambda (health/ready 200, puzzle generation 200) on an rc-* workspace.
#
# Build the app first (HTTP fast-jar — the only build; no separate Lambda-zip profile):
#   ./mvnw package -DskipTests
# Then build the image:
#   docker build -f src/main/docker/Dockerfile.jvm-lwa -t sudoku-backend .
# Run locally (HTTP only):
#   docker run -i --rm -p 8080:8080 sudoku-backend
###
FROM amazoncorretto:25

ENV LANGUAGE='en_US:en'

# AWS Lambda Web Adapter — inert unless running inside AWS Lambda. Pinned to a released tag.
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:1.0.1 /lambda-adapter /opt/extensions/lambda-adapter
# Matches the Quarkus HTTP port. Only consulted inside Lambda; ignored on Cloud Run.
ENV AWS_LWA_PORT="8080"
# Readiness gate: the adapter waits for this to return 200 before routing Lambda invocations
# to the app. Only consulted inside Lambda; ignored on Cloud Run.
ENV AWS_LWA_READINESS_CHECK_PATH="/api/v1/q/health/ready"

# Four distinct layers so library layers can be re-used across application-only changes.
# Files are left root-owned and world-readable (Maven's default 644/755) so Lambda's
# least-privileged runtime user can read them without a chown.
COPY target/quarkus-app/lib/ /deployments/lib/
COPY target/quarkus-app/*.jar /deployments/
COPY target/quarkus-app/app/ /deployments/app/
COPY target/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080

# Run as a non-root user. The /deployments files are root-owned but world-readable and the java
# binary is world-executable, so no chown is needed. On Lambda the USER is moot (Lambda runs the
# container as its own least-privileged sandbox user); this hardens the Cloud Run path.
USER 1001

# Exec the JVM directly (absolute path via Corretto's JAVA_HOME). `exec` makes java PID 1 so it
# receives signals. The two -D options bind all interfaces and select the JBoss LogManager Quarkus
# needs. Identical behaviour on Cloud Run and Lambda.
ENTRYPOINT [ "/bin/sh", "-c", \
  "exec \"$JAVA_HOME/bin/java\" -Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager -jar /deployments/quarkus-run.jar" ]
