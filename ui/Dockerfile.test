# Builds the Vite app and serves it with `vite preview` for integration testing.
# Used by docker-compose.test.yml only; not deployed to production.
FROM node:25-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --legacy-peer-deps
COPY . .
# Build-time vars injected via --build-arg in docker-compose.test.yml
ARG VITE_API_URL=http://localhost:8080/api/v1
ARG VITE_MOCK_API=false
ARG VITE_SKIP_AUTH=false
ARG VITE_DEV_TOOLS=false
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_MOCK_API=$VITE_MOCK_API
ENV VITE_SKIP_AUTH=$VITE_SKIP_AUTH
ENV VITE_DEV_TOOLS=$VITE_DEV_TOOLS
RUN npm run build

FROM node:25-slim
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/package.json ./
EXPOSE 5174
CMD ["npx", "vite", "preview", "--host", "0.0.0.0", "--port", "5174"]
