        <mxCell id="ar_be" value="Artifact Registry&#10;sudoku-backend (backend image)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;" vertex="1" parent="1">
