# --- Pulumi / Python ---
# uv-managed virtualenv (each Pulumi.yaml points at ../.venv)
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# Ephemeral stack configs generated on the fly (prod's Pulumi.prod.yaml is committed)
app/Pulumi.rcg-*.yaml

# Pulumi local state from the bootstrap stack's first run, and its state export.
# Neither belongs in git — see docs/planning/gcp-pulumi-phase-2-bootstrap.md §3.
.pulumi/
bootstrap-state-backup.json
