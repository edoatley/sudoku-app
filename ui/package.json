{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "biome check .",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:hint-demos": "playwright test tests/integration/hint-demos.spec.js --config playwright.integration.config.js",
    "test:hint-demos:local": "playwright test tests/integration/hint-demos.spec.js --config playwright.hint-demos.local.config.js",
    "test:coach-quality": "playwright test --config playwright.coach-quality.config.js",
    "test:coach-quality:aggregate": "node tests/coach-quality/lib/aggregate.js"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.6",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "aws-amplify": "^6.20.0",
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "overrides": {
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "jwt-decode": "^4.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
