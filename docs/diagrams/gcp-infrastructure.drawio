        </mxCell>
        <mxCell id="ar_ir" value="Artifact Registry&#10;sudoku-image-recognition (image)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="360" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Runtime / compute group (now live) -->
        <mxCell id="gated_lbl" value="Runtime (live in prod · phased flags on; RC/dev via workspace)" style="text;html=1;fontSize=12;fontStyle=1;align=left;fontColor=#1A73E8;" vertex="1" parent="1">
          <mxGeometry x="420" y="450" width="420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="run_be" value="Cloud Run: sudoku (backend)&#10;512MiB · scale-to-zero · in-app JWT&#10;coach: cross-cloud Bedrock / Vertex" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="480" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="run_ir" value="Cloud Run: image-recognition&#10;Python · cross-cloud Bedrock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="480" width="240" height="65" as="geometry" />
        </mxCell>
        <mxCell id="dns" value="Custom domain (no Cloud DNS zone)&#10;sudoku-gcp.edoatley.co.uk&#10;CNAME in parent Route53 zone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="480" width="240" height="65" as="geometry" />
