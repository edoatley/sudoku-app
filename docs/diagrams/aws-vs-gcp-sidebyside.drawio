<mxfile host="app.diagrams.net">
  <diagram id="aws-vs-gcp" name="AWS vs GCP side by side">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1400" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Sudoku — one codebase, one container image, two clouds (side-by-side)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Same fast-jar HTTP image (Dockerfile.jvm-lwa); behaviour is picked by Quarkus config profile + env vars — no per-cloud code branches. See aws-vs-gcp-comparison.md." style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1200" height="20" as="geometry" />
        </mxCell>

        <!-- Column headers -->
        <mxCell id="hdr_dim" value="Dimension" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hdr_aws" value="AWS — eu-west-2 (London)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9900;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="250" y="90" width="540" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hdr_gcp" value="GCP — us-central1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="800" y="90" width="540" height="40" as="geometry" />
        </mxCell>

        <!-- Row 1: Auth edge -->
        <mxCell id="d1" value="Auth edge&#10;(biggest divergence)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="Validate at the door — API Gateway JWT authorizer verifies the Cognito token before Lambda runs; app trusts claims (oidc application-type=service, never re-validates)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9900;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="250" y="140" width="540" height="80" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="Validate in-app — no edge authorizer on Cloud Run; Quarkus OIDC validates every request (issuer pinned, discovery off, explicit Firebase JWKS). All token-shape bugs surface only here." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="140" width="540" height="80" as="geometry" />
        </mxCell>

        <!-- Row 2: Compute -->
        <mxCell id="d2" value="Compute&#10;(backend)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="Lambda (container image, 512MB/8s) behind API Gateway HTTP v2; Lambda Web Adapter bridges API GW → app :8080. live alias." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9900;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="250" y="230" width="540" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="Cloud Run (same container, 512MiB/60s, scale-to-zero) served direct as a plain HTTP server :8080; the Lambda adapter is inert." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="230" width="540" height="70" as="geometry" />
        </mxCell>

        <!-- Row 3: Persistence -->
        <mxCell id="d3" value="Persistence" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="DynamoDB — 4 on-demand tables (per-env table names). Auth via Lambda execution role (IAM)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9900;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="250" y="310" width="540" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="Firestore Native — named database per Terraform workspace ((default) vs sudoku&lt;suffix&gt;). Auth via runtime SA sudoku-run@ (ADC, roles/datastore.user)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="310" width="540" height="70" as="geometry" />
        </mxCell>

        <!-- Row 4: Identity -->
        <mxCell id="d4" value="Identity provider" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="Amazon Cognito user pool (Google IdP). userId = Cognito subject. Admin via Cognito group." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9900;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="250" y="390" width="540" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="Identity Platform / Firebase Auth (Google). userId = Google sub (cross-cloud stable). No group concept → admin authz deferred (UM-GCP-008)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="390" width="540" height="70" as="geometry" />
        </mxCell>

        <!-- Row 5: AI coach -->
        <mxCell id="d5" value="AI coach (LLM)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="Bedrock, direct — Lambda role carries Bedrock IAM; eu-west-2 inference profile (Claude Haiku 4.5)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9900;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="250" y="470" width="540" height="80" as="geometry" />
        </mxCell>
        <mxCell id="g5" value="coach_ai_provider (default bedrock): cross-cloud Bedrock (AWS keys from Secret Manager → AWS_* env, calls eu-west-2) OR native Vertex AI (Gemini via ADC, no keys). Image-rec always Bedrock." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="470" width="540" height="80" as="geometry" />
        </mxCell>

        <!-- Row 6: Frontend + CORS -->
        <mxCell id="d6" value="Frontend + CORS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="AWS Amplify hosting; CORS handled at API Gateway." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9900;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="250" y="560" width="540" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g6" value="Firebase Hosting (SPA rewrites); CORS handled in-app by CorsFilter (%gcp profile) — no gateway." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="560" width="540" height="70" as="geometry" />
        </mxCell>

        <!-- Row 7: DNS / TLS -->
        <mxCell id="d7" value="DNS &amp; TLS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="Route53 delegated zones (sudoku / sudoku-beta .edoatley.co.uk) + ACM certs; Amplify ALIAS." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9900;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="250" y="640" width="540" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g7" value="sudoku-gcp.edoatley.co.uk = single CNAME to the Firebase default site, upserted in the parent Route53 zone (no Cloud DNS zone). Google-managed TLS." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="640" width="540" height="70" as="geometry" />
        </mxCell>

        <!-- Row 8: Cost controls -->
        <mxCell id="d8" value="Cost controls" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="720" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a8" value="AWS Budgets with enforcement — budget action auto-attaches a deny policy to the Lambda role at 100% Bedrock spend; anomaly monitor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9900;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="250" y="720" width="540" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g8" value="Cloud Billing budget — alert-only (80%/100% via Pub/Sub + notification channel). Hard-cap deferred (CP-GCP-061)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="720" width="540" height="70" as="geometry" />
        </mxCell>

        <!-- Row 9: IaC + deploy -->
        <mxCell id="d9" value="IaC &amp; deploy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="a9" value="infra/aws Terraform. GitHub OIDC → assume-role. Image → ECR. Frontend via Amplify build hook. Prod = push to main (continuous). Post-deploy smoke via Cognito USER_PASSWORD_AUTH." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9900;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="250" y="800" width="540" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g9" value="infra/gcp Terraform + one-time bootstrap.sh (project/APIs/SAs/WIF). Workload Identity Federation → impersonate deploy SA. Image → Artifact Registry. Frontend via firebase deploy job. Prod = manual workflow_dispatch (phased flags). Smoke via Identity Platform signInWithPassword." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="800" width="540" height="90" as="geometry" />
        </mxCell>

        <!-- Footer legend -->
        <mxCell id="legend" value="Orange = AWS · Blue = GCP · Dimension rows are keyed to the &quot;At a glance&quot; table in aws-vs-gcp-comparison.md. Deployment/pipeline detail: aws-vs-gcp-deployment.md." style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fillColor=#FFFDE7;strokeColor=#E0E0E0;" vertex="1" parent="1">
          <mxGeometry x="40" y="910" width="1300" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
