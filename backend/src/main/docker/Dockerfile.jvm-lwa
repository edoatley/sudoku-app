####
# Unified HTTP container image for the Quarkus backend, used on BOTH clouds:
#   - Google Cloud Run: runs the app as a plain HTTP server on :8080.
#   - AWS Lambda (container): the AWS Lambda Web Adapter extension (baked in below) bridges the
#     Lambda Runtime API to the same HTTP server, so no code or handler change is needed.
# The adapter is a Lambda "extension"; outside a Lambda execution environment (e.g. on Cloud Run)
# it is never invoked and stays completely inert.
#
# Build the app first (HTTP fast-jar — the only build; no separate Lambda-zip profile):
#   ./mvnw package -DskipTests
# Then build the image:
#   docker build -f src/main/docker/Dockerfile.jvm-lwa -t sudoku-backend .
# Run locally (HTTP only):
#   docker run -i --rm -p 8080:8080 sudoku-backend
###
FROM registry.access.redhat.com/ubi9/openjdk-25-runtime

ENV LANGUAGE='en_US:en'

# AWS Lambda Web Adapter — inert unless running inside AWS Lambda. Pinned to a released tag.
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1 /lambda-adapter /opt/extensions/lambda-adapter
# Matches the Quarkus HTTP port. Only consulted inside Lambda; ignored on Cloud Run.
ENV AWS_LWA_PORT="8080"
# Readiness gate: the adapter waits for this to return 200 before routing Lambda invocations
# to the app. Only consulted inside Lambda; ignored on Cloud Run.
ENV AWS_LWA_READINESS_CHECK_PATH="/api/v1/q/health/ready"

# Four distinct layers so library layers can be re-used across application-only changes.
COPY --chown=185 target/quarkus-app/lib/ /deployments/lib/
COPY --chown=185 target/quarkus-app/*.jar /deployments/
COPY --chown=185 target/quarkus-app/app/ /deployments/app/
COPY --chown=185 target/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080
USER 185

# Exec the JVM directly rather than via the UBI `run-java.sh` wrapper. AWS Lambda's container
# runtime rejects the shell-script entrypoint with `Runtime.InvalidEntrypoint: ... run-java.sh:
# permission denied` (it requires an absolute-path, non-script entrypoint), even though the same
# image boots fine on Cloud Run and `docker run`. Invoking the resolved `java` binary directly is
# the portable form: identical behaviour on both clouds. The two -D options replicate what
# JAVA_OPTS_APPEND fed to run-java.sh (bind all interfaces; use the JBoss LogManager Quarkus needs).
ENTRYPOINT [ "/usr/lib/jvm/java-25-openjdk/bin/java", \
             "-Dquarkus.http.host=0.0.0.0", \
             "-Djava.util.logging.manager=org.jboss.logmanager.LogManager", \
             "-jar", "/deployments/quarkus-run.jar" ]
