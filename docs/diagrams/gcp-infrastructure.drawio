        <mxCell id="idp" value="Identity Platform + Google IdP&#10;(manual · not Terraform)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF7E0;strokeColor=#F9AB00;dashed=1;fontSize=12;" vertex="1" parent="1">
