        <mxCell id="e6" value="datastore.user" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;labelBackgroundColor=#ffffff;fontSize=10;strokeColor=#F9AB00;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="sa_run" target="firestore">
