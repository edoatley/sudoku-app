        <!-- Legend -->
        <mxCell id="legend" value="Solid blue = deployed compute/data/hosting · Amber = identity/SA (dashed = manual, not Terraform) · Coach LLM selectable via coach_ai_provider (Bedrock default | Vertex AI)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fillColor=#FFFDE7;strokeColor=#E0E0E0;" vertex="1" parent="1">
          <mxGeometry x="420" y="590" width="1000" height="30" as="geometry" />
